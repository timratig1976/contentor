{
  "hubId": "context-db",
  "active": true,
  "name": "Context DB",
  "version": "1.0.0",
  "description": "[Tool] Postgres Context-DB. Kunden, Projekte, SOP-Status, Kontext, Angles, Content, Medien, Strategien. Single Source of Truth.",
  "author": "timratig",
  "license": "viminds internal",
  "examples": [
    {
      "prompt": "Zeige alle Kunden in der DB.",
      "call": "{\"action\": \"list_kunden\"}"
    },
    {
      "prompt": "Suche Kunde Müller GmbH.",
      "call": "{\"action\": \"find_kunde\", \"name\": \"Müller\"}"
    },
    {
      "prompt": "Erstelle Kunde Acme GmbH mit KKZ ACM.",
      "call": "{\"action\": \"create_kunde\", \"name\": \"Acme GmbH\", \"kkz\": \"ACM\"}"
    },
    {
      "prompt": "Speichere Strategie-Kontext für Projekt 5, Step V4.",
      "call": "{\"action\": \"set_kontext\", \"projekt_id\": 5, \"step_code\": \"V4\", \"key\": \"strategie\", \"content\": \"...\"}"
    }
  ],
  "setup_args": {
    "DB_URL": {
      "type": "string",
      "required": true,
      "input": {
        "type": "text",
        "default": "",
        "placeholder": "postgresql://user:pass@host:5432/db",
        "hint": "Desktop/Extern: postgresql://aicontext:***@ai.viminds.de:5433/context_db | Server/Intern: postgresql://aicontext:***@postgres-context:5432/context_db"
      },
      "value": "postgresql://aicontext:67omQO5jkD5C25AwZZ7XoAgipBXz6GFBqzDaMYhAS5j5Y5MloEUBJ2Z33SrX9cWb@ai.viminds.de:5433/context_db"
    }
  },
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "action": {
        "description": "debug | setup_schema | list_kunden | find_kunde | create_kunde | update_kunde | list_projekte | create_projekt | update_projekt | get_integrations | set_integrations | get_kontext | set_kontext | get_sop_run | advance_sop_step | list_dateien | register_datei | create_angle | list_angles | get_angle | update_angle | create_content_item | list_content_items | get_content_item | update_content_item | set_strategy | get_strategy | list_strategies | delete_strategy | create_media | list_media | get_media | update_media | delete_media | get_file",
