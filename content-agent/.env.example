EDENAI_API_KEY=
CONTENT_API_URL=http://localhost:8000/api
CONTENT_UNIT=viscale

# Pro Agent: Provider & Model (via EdenAI)
# Provider: openai, google, anthropic, mistral, meta, cohere, deepseek, etc.
# Model: gpt-4o, claude-sonnet-4-6, gemini-2.0-flash, mistral-large, etc.
# Reasoning: none|low|medium|high (Anthropic→output_config.effort, OpenAI o-Serie/gpt-5→reasoning_effort)
RESEARCH_PROVIDER=anthropic
RESEARCH_MODEL=claude-sonnet-4-6
RESEARCH_REASONING=medium
ANGLE_PROVIDER=anthropic
ANGLE_MODEL=claude-sonnet-4-6
ANGLE_REASONING=medium
PRODUCTION_PROVIDER=anthropic
PRODUCTION_MODEL=claude-sonnet-4-6
PRODUCTION_REASONING=medium
REVIEW_PROVIDER=openai
REVIEW_MODEL=gpt-4o
REVIEW_REASONING=low
COORDINATOR_PROVIDER=openai
COORDINATOR_MODEL=gpt-4o
COORDINATOR_REASONING=low